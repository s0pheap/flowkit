# ==============================================================================
# FlowKit Environment Configuration Template
# Copy this file to .env and adjust the values for your setup.
# ==============================================================================

# ─── Google Flow Project ──────────────────────────────────────────────────────
# The Google Flow project UUID every generation RPC is scoped to.
# Open https://flow.google.com/, create or open a project, and copy the UUID from the URL.
# Example: https://flow.google.com/project/c44bcef5-de99-4b52-b8a5-27f0fe67bc67
FLOW_PROJECT_ID=c44bcef5-de99-4b52-b8a5-27f0fe67bc67

# Whether to allow fallback when advanced features (e.g. chaining, r2v) fail (0 or 1)
FLOW_ALLOW_DEGRADED=0

# Default paygate tier (PAYGATE_TIER_TWO enables 4K upscale)
DEFAULT_PAYGATE_TIER=PAYGATE_TIER_TWO

# ─── FlowKit API & Extension Server ───────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8100

# API keys. Leave off for a local agent. Turn on before anyone else can reach
# :8100: every /api and /ws call then needs X-API-Key, users only see the Flow
# projects granted to them, and server-wide settings are admin-only.
# Manage users with: python -m agent.users create <name> --project <flow-uuid>
AUTH_ENABLED=0
# Bootstrap admin key (long and random, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))")
ADMIN_API_KEY=
# Public address users reach this agent at; written into /install.sh and /install.ps1.
# Leave empty to use the address each request came in on. See docs/DEPLOY.md.
PUBLIC_URL=

# Docker only (docker-compose.yml): the domain Caddy gets a certificate for, and
# the login for the Chromium web desktop you sign in to Flow on.
DOMAIN=
BROWSER_PASSWORD=

# ─── Server-side final render ─────────────────────────────────────────────────
# Font file for burned-in text overlays and font name for burned-in subtitles.
# Leave empty to pick one for the OS (needs a CJK font for Korean/Japanese/Chinese).
OVERLAY_FONT=
SUBTITLE_FONT=
# Extra font files for burned subtitles. Khmer uses Kantumruy Pro when KantumruyPro-*.ttf is here.
# Empty = output/_shared/fonts
SUBTITLE_FONTS_DIR=

# WebSocket server for Chrome extension bridge (no key check: keep it on 127.0.0.1)
WS_HOST=127.0.0.1
WS_PORT=9222

# ─── TTS Narration ────────────────────────────────────────────────────────────
# TTS engine: "gemini" (default), "mindlogic" (Gemini TTS through the Mindlogic API gateway),
# "kokoro" (your own Kokoro-82M server), "piper" (free, runs locally), "google" (free gTTS) or "omnivoice"
TTS_ENGINE=gemini
# When TTS_ENGINE can't speak a line (a language it doesn't know, Gemini out of quota, Kokoro
# server down), use these instead: comma-separated, tried in order, "none" = fail.
# Piper is free and runs on this machine (Korean yes, Khmer no); google (gTTS) also speaks Khmer.
TTS_FALLBACK_ENGINE=piper,google

# Kokoro-82M server (TTS_ENGINE=kokoro): POST {text, voice, speed, lang_code} -> wav.
# Speaks en, es, fr, hi, it, pt, ja, zh; other languages go to TTS_FALLBACK_ENGINE.
KOKORO_URL=
# Voice for lines in its language (af_heart, bf_emma, am_michael, ...). Empty = a default per language.
KOKORO_VOICE=

# Mindlogic API gateway (TTS_ENGINE=mindlogic, or add "mindlogic" to TTS_FALLBACK_ENGINE).
# Gemini TTS billed in gateway credits: same voices as GEMINI_TTS_VOICE, most languages
# (Korean yes, Khmer check), 4,000 characters per line, 120 requests a minute.
# https://docs.mindlogic.ai/docs/cbnu-ac/api-gateway/reference/audio-tts
MINDLOGIC_API_KEY=
MINDLOGIC_TTS_MODEL=gemini-3.1-flash-tts-preview
# Empty = GEMINI_TTS_VOICE (Kore, Charon, Aoede, Puck, ...)
MINDLOGIC_TTS_VOICE=
# Piper voice name (https://huggingface.co/rhasspy/piper-voices, e.g. en_US-ryan-high)
# or a path to an .onnx file. Empty = a default voice for the project's language.
PIPER_VOICE=

# Gemini API key (https://aistudio.google.com/apikey). Speaks the narration and
# times every word for subtitles. Without it, TTS_ENGINE=gemini fails and word
# timings fall back to an estimate.
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# Default prebuilt voice (Kore, Charon, Puck, Fenrir, Aoede, Orus, ...)
GEMINI_TTS_VOICE=Kore
# Audio model that reports word timings
GEMINI_TIMING_MODEL=gemini-2.5-flash
# Parallel Gemini calls during a whole-video narrate (preview models have low rate limits)
GEMINI_TTS_CONCURRENCY=2
# Seconds to stop calling Gemini after its daily quota runs out
GEMINI_QUOTA_COOLDOWN=3600

# Word timings for subtitles, tried in order: gemini (GEMINI_TIMING_MODEL) and/or
# whisper (local, no quota; pip install faster-whisper). E.g. whisper,gemini
TIMING_ENGINE=gemini
# Whisper model: a size (tiny, base, small, medium, large-v3) downloaded on first use,
# or a local model folder such as output/_shared/whisper/faster-whisper-small
WHISPER_MODEL=small
# auto = GPU when CUDA libraries are present, else CPU
WHISPER_DEVICE=auto

# gTTS only: language code (e.g., en, ko) and accent domain (com = US, co.uk = UK)
TTS_LANG=en
TTS_TLD=com

# ─── Video Review (AI Vision) ─────────────────────────────────────────────────
# Anthropic API key for Claude Vision video quality review (/fk-review-video)
ANTHROPIC_API_KEY=

# ─── Music Generation (Suno API) ──────────────────────────────────────────────
# API key from sunoapi.org for background music generation (/fk-gen-music)
SUNO_API_KEY=
SUNO_BASE_URL=https://api.sunoapi.org
SUNO_MODEL=V4

# ─── Worker & Throttling ──────────────────────────────────────────────────────
POLL_INTERVAL=5
VIDEO_POLL_INTERVAL=10
VIDEO_POLL_TIMEOUT=420
API_COOLDOWN=10
MAX_CONCURRENT_REQUESTS=5
